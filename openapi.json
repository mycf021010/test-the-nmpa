              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "summary": "Categories",
        "description": "返回前端可选择的采集类别。",
        "operationId": "categories_api_v1_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
