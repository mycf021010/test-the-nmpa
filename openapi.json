                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/resume": {
      "post": {
        "summary": "Resume Collection",
        "description": "继续原任务：范围和编号保持不变，worker 读取原目录中的断点。",
        "operationId": "resume_collection_api_v1_jobs__job_id__resume_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/import": {
      "post": {
        "summary": "Import Preview",
        "description": "校验试采文件后原子排队入库，重复确认会被拒绝。",
        "operationId": "import_preview_api_v1_jobs__job_id__import_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/records": {
      "get": {
        "summary": "Records",
        "description": "分页读取标准 CSV，避免将全部数据一次发送给页面。",
        "operationId": "records_api_v1_jobs__job_id__records_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "domestic",
          "domestic_history",
          "imported",
          "imported_history"
        ],
        "title": "Category",
        "description": "四种采集类别的枚举，避免把页面中文名称当作接口参数。"
      },
      "CollectRequest": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Categories"
          },
          "keywords": {
            "items": {
              "$ref": "#/components/schemas/Keyword"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 1,
            "title": "Keywords"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          },
          "max_pages": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Max Pages",
            "default": 0
          },
          "page_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CollectRequest",
        "description": "Python 接口的请求模型，负责类别、关键词和限页模式校验。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Request Id"
          },
          "daily_task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Daily Task Id"
          },
          "subtask_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Subtask Id"
          },
          "round_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Round Id"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "keyword": {
            "$ref": "#/components/schemas/Keyword"
          },
          "target_records": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 80.0,
            "title": "Target Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "daily_task_id",
          "subtask_id",
          "round_id",
          "category",
          "keyword",
          "target_records"
        ],
        "title": "JobRequest",
        "description": "提交当天单类别单关键词的限量任务，数量单位为来源记录。"
      },
      "Keyword": {
        "type": "string",
        "enum": [
          "膝",
          "髋"
        ],
        "title": "Keyword",
        "description": "支持的关节关键词枚举。"
      },
      "RoundRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Request Id"
          },
          "page_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "RoundRequest",
        "description": "以幂等请求编号打开当前轮；每轮固定来源每页条数。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
